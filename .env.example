# ==============================================================================
# InterviewAce Environment Configuration
# All external keys are optional in dev mode: missing keys flip providers to
# deterministic mocks so local development and unit tests run with zero setup.
# ==============================================================================

# ---- App Settings ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Comma-separated admin emails permitted to access the /admin dashboard
ADMIN_EMAILS=admin@interviewace.app,you@example.com

# Emergency AI kill switch: set to 1 or true to instantly disable LLM endpoints
AI_KILL_SWITCH=0

# Secret for authenticating internal cron requests (Authorization: Bearer <secret>)
CRON_SECRET=dev-cron-secret-32-chars-long-random-string

# Per-user daily AI cost cap in cents (default 40 = $0.40/day)
AI_DAILY_BUDGET_CENTS=40

# Per-user daily AI request count cap
AI_DAILY_REQUEST_CAP=120

# Optional extra disposable email domains to block at signup (comma-separated)
DISPOSABLE_EMAIL_DOMAINS=tempinbox.net,trashmail.org

# ---- Supabase (PostgreSQL + Auth + Storage) ----
# https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy-service-role-key

# ---- Anthropic Claude LLM ----
# https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---- OpenAI (Whisper Audio Transcription & TTS-1 Speech Synthesis) ----
# https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# ---- Stripe (Billing & Checkout) ----
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Stripe Price IDs (from Stripe Dashboard > Products)
STRIPE_PRICE_WEEKLY=price_dummy_weekly_trial
STRIPE_PRICE_MONTHLY=price_dummy_monthly
STRIPE_PRICE_LANDJOB=price_dummy_landjob_60day

# ---- Resend (Transactional & Lifecycle Emails) ----
# https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM="InterviewAce <hello@interviewace.app>"

# ---- PostHog Analytics ----
# https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_dummy_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Sentry Error Monitoring ----
# https://sentry.io
SENTRY_DSN=https://dummyPublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://dummyPublicKey@o0.ingest.sentry.io/0
