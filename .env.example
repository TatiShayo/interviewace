# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated admin emails for /admin access
ADMIN_EMAILS=you@example.com
# Set to 1 to instantly disable all AI features without redeploy (kill switch)
AI_KILL_SWITCH=
# Secret for signing internal cron requests (any long random string)
CRON_SECRET=change-me

# ---- Supabase (3) --- https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Anthropic --- https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---- OpenAI (Whisper transcription + TTS voice) ----
OPENAI_API_KEY=

# ---- Stripe (3) --- https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs (create products first; see README "Stripe setup")
STRIPE_PRICE_WEEKLY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_LANDJOB=

# ---- Resend (lifecycle + dunning emails) ----
RESEND_API_KEY=
RESEND_FROM="InterviewAce <hello@yourdomain.com>"

# ---- PostHog analytics ----
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Sentry error monitoring ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
